# Salin berkas ini menjadi ".env" untuk uji coba di komputer sendiri.
# Di Render TIDAK pakai berkas .env: isi semua ini di menu Environment (lihat panduan).

# --- Database ---------------------------------------------------------------
# Komputer sendiri (database dari "npm run dev:db"):
DATABASE_URL=postgres://postgres:postgres@localhost:5433/p2h
# Di Render: isi dengan "Internal Database URL" milik database Render Anda.

# --- Keamanan (buat dengan: npm run keys) ---------------------------------
JWT_SECRET=ganti-dengan-teks-acak-panjang-minimal-32-karakter-ya
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:emailanda@perusahaan.co.id

# --- Alamat web (Vercel) yang boleh memanggil server ini ----------------------
# Pisahkan dengan koma bila lebih dari satu. Tanpa garis miring di ujung.
CORS_ORIGINS=http://localhost:5173
APP_URL=http://localhost:5173

# --- Akun admin pertama (dibuat otomatis kalau belum ada admin) ------------------
ADMIN_NRP=admin
ADMIN_NAME=Administrator
ADMIN_PASSWORD=GantiPasswordIni123

# --- Lain-lain (boleh dibiarkan) -------------------------------------------
PORT=4000
# DATABASE_SSL=auto
