# Salin berkas ini menjadi ".env" untuk uji coba di komputer sendiri.
# Di Render TIDAK pakai berkas .env: isi semua ini di menu Environment (lihat panduan).

# --- Database ---------------------------------------------------------------
# Komputer sendiri (database dari "npm run dev:db"):
DATABASE_URL=postgres://postgres:postgres@localhost:5433/p2h
# Di Render + Aiven: isi dengan "Service URI" dari halaman Overview database Aiven, contoh:
#   postgres://avnadmin:KATASANDI@pg-nama-proyek.aivencloud.com:12345/defaultdb?sslmode=require
# (bagian ?sslmode=require boleh dibiarkan; server mengurusnya sendiri)

# Sertifikat CA dari Aiven (tombol "Download" di samping "CA certificate"). BOLEH KOSONG:
# koneksi tetap terenkripsi, hanya saja sertifikat server tidak diperiksa.
# Kalau diisi, tempel seluruh isi berkas ca.pem. Boleh ditulis satu baris dengan \n sebagai pengganti baris baru.
# DATABASE_CA=

# --- Keamanan (buat dengan: npm run keys) ---------------------------------
JWT_SECRET=ganti-dengan-teks-acak-panjang-minimal-32-karakter-ya
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:emailanda@perusahaan.co.id

# --- Alamat aplikasi -----------------------------------------------------------
# Kalau tampilan web ikut disajikan server ini (cara standar: satu layanan di Render), BIARKAN KOSONG.
# Di Render alamat aplikasi terisi otomatis (RENDER_EXTERNAL_URL).
# Isi hanya kalau tampilan web dipasang di alamat lain dari server ini (mis. Vercel / Netlify):
# CORS_ORIGINS=https://alamat-web-anda.example.com   (pisahkan dengan koma bila lebih dari satu; tanpa garis miring di ujung)
# APP_URL=https://alamat-web-anda.example.com
CORS_ORIGINS=http://localhost:5173
APP_URL=http://localhost:5173

# --- Akun admin pertama (dibuat otomatis kalau belum ada admin) ------------------
# ADMIN_NRP adalah No SID admin (dipakai untuk masuk).
ADMIN_NRP=admin
ADMIN_NAME=Administrator
ADMIN_PASSWORD=GantiPasswordIni123

# --- Lain-lain (boleh dibiarkan) -------------------------------------------
PORT=4000
# DATABASE_SSL=auto      (auto | true | false)
# WEB_DIR=               (folder hasil build tampilan web; bawaan: ../frontend/dist)
