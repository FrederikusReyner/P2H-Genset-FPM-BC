# Alamat server. BIARKAN KOSONG pada cara standar: tampilan web dan server berada di satu layanan (Render),
# jadi aplikasi otomatis memanggil server di alamat yang sama. Di komputer sendiri juga kosong
# (otomatis memakai server lokal di port 4000).
#
# Isi hanya kalau tampilan web dipasang di alamat LAIN dari server (mis. Vercel / Netlify), tanpa garis miring di ujung:
#   VITE_API_URL=https://p2h-genset.onrender.com
# (dan di server isi CORS_ORIGINS dengan alamat web itu)
VITE_API_URL=
